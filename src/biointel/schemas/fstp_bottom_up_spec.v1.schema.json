{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biointel.internal/schemas/fstp_bottom_up_spec.v1.json",
  "title": "FSTPBottomUpSpecificationV1",
  "description": "Standardized first-principles engineering model specification linking BioIntel biophysical units to FSTP macro learning curves.",
  "type": "object",
  "required": [
    "technology_id",
    "domain",
    "category",
    "as_of_date",
    "scale_unit",
    "scale_value",
    "thermodynamic_cost_floor_usd_per_unit",
    "cost_stack_usd_per_unit",
    "physical_bottlenecks",
    "utility_targets",
    "fstp_integration_metadata",
    "model_provenance_seal"
  ],
  "properties": {
    "technology_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Canonical lower snake_case technology identifier."
    },
    "domain": {
      "type": "string",
      "description": "Broad technical domain (e.g. industrial_biotechnology, genetic_medicine)."
    },
    "category": {
      "type": "string",
      "description": "Sub-domain classification."
    },
    "as_of_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Effective snapshot date in YYYY-MM-DD format (point-in-time invariant)."
    },
    "scale_unit": {
      "type": "string",
      "description": "Unit of manufacturing capacity (e.g. MT_per_year, doses_per_year)."
    },
    "scale_value": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Nominal nameplate production scale."
    },
    "thermodynamic_cost_floor_usd_per_unit": {
      "type": "number",
      "minimum": 0,
      "description": "Asymptotic first-principles cost floor C_floor in USD per scale_unit."
    },
    "thermodynamic_cost_floor_usd_per_kg": {
      "type": "number",
      "minimum": 0,
      "description": "Backwards compatibility alias for per-kg commodities."
    },
    "cost_stack_usd_per_unit": {
      "type": "object",
      "description": "Disaggregated unit-operation cost breakdown.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "cost_stack_usd_per_kg": {
      "type": "object",
      "description": "Backwards compatibility alias for per-kg commodities.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "physical_bottlenecks": {
      "type": "object",
      "required": ["limiting_regime"],
      "properties": {
        "limiting_regime": {
          "type": "string",
          "description": "Rate-determining physical or transport mechanism."
        },
        "thiele_modulus": {
          "type": "number",
          "minimum": 0
        },
        "effectiveness_factor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0
        },
        "damkohler_number": {
          "type": "number",
          "minimum": 0
        },
        "mixing_timescale_ms": {
          "type": "number",
          "minimum": 0
        },
        "final_conversion_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100.0
        },
        "encapsulation_efficiency_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100.0
        }
      },
      "additionalProperties": true
    },
    "utility_targets": {
      "type": "object",
      "description": "Plant energy, cooling, cleanroom, or solvent recovery targets.",
      "additionalProperties": true
    },
    "fstp_integration_metadata": {
      "type": "object",
      "required": [
        "confidence_tier",
        "confidence_label",
        "recommended_wrights_law_asymptote_usd",
        "incumbent_market_clearing_parity_ratio"
      ],
      "properties": {
        "confidence_tier": {
          "type": "integer",
          "enum": [1, 2, 3]
        },
        "confidence_label": {
          "type": "string"
        },
        "recommended_wrights_law_asymptote_usd": {
          "type": "number",
          "minimum": 0
        },
        "incumbent_market_clearing_parity_ratio": {
          "type": "number"
        },
        "substitution_barrier": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "regional_cost_matrix_usd": {
      "type": "object",
      "description": "Multi-regional cost benchmark matrix (US, Western Europe, East Asia) mitigating western baseline bias.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "region_id": { "type": "string" },
          "region_name": { "type": "string" },
          "unit_cost_usd": { "type": "number" },
          "cost_delta_vs_us_pct": { "type": "number" },
          "electricity_contribution_usd": { "type": "number" },
          "labor_contribution_usd": { "type": "number" },
          "capex_contribution_usd": { "type": "number" },
          "feedstock_contribution_usd": { "type": "number" },
          "commercial_viability_verdict": { "type": "string" }
        },
        "required": ["region_id", "unit_cost_usd", "cost_delta_vs_us_pct"]
      }
    },
    "scale_elasticity": {
      "type": "object",
      "description": "Continuous unit-operation power-law scaling curve mitigating point-scale bias.",
      "properties": {
        "technology_id": { "type": "string" },
        "scale_unit": { "type": "string" },
        "reference_scale": { "type": "number" },
        "scaling_exponent_alpha": { "type": "number" },
        "variable_cost_floor_usd": { "type": "number" },
        "fixed_capex_cost_ref_usd": { "type": "number" },
        "curve_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scale_value": { "type": "number" },
              "scale_unit": { "type": "string" },
              "unit_cost_usd": { "type": "number" },
              "capex_contribution_usd": { "type": "number" },
              "variable_cost_usd": { "type": "number" },
              "scale_label": { "type": "string" }
            },
            "required": ["scale_value", "unit_cost_usd", "scale_label"]
          }
        }
      },
      "required": ["technology_id", "scaling_exponent_alpha", "curve_points"]
    },
    "operational_derating": {
      "type": "object",
      "description": "Operational commissioning ramp-up schedule and batch scrap loss mitigating steady-state bias.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "year": { "type": "integer" },
          "operational_stage": { "type": "string" },
          "effective_capacity_factor_pct": { "type": "number" },
          "steady_state_cost_usd": { "type": "number" },
          "fixed_overhead_inflation_multiplier": { "type": "number" },
          "batch_contamination_loss_pct": { "type": "number" },
          "fto_licensing_royalty_pct": { "type": "number" },
          "physical_cost_floor_usd": { "type": "number" },
          "commercial_clearing_cost_usd": { "type": "number" }
        },
        "required": ["year", "operational_stage", "effective_capacity_factor_pct", "commercial_clearing_cost_usd"]
      }
    },
    "fto_royalty_drag_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 50,
      "description": "Freedom-to-Operate patent royalty stack drag mitigating IP blindspot bias."
    },
    "model_provenance_seal": {
      "type": "string",
      "pattern": "^SEAL_FSTP_[A-F0-9]{16}$",
      "description": "Cryptographic SHA-256 integrity seal over canonical JSON payload."
    }
  },
  "additionalProperties": false
}
